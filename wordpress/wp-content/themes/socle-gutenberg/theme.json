{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1680px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "fond",
					"color": "#F3F4F6",
					"name": "Blanc"
				},
				{
					"slug": "fond-2",
					"color": "#D3D5E4",
					"name": "Gris"
				},
				{
					"slug": "encre",
					"color": "#2E3041",
					"name": "Noir"
				},
				{
					"slug": "doux",
					"color": "#4B4E63",
					"name": "Texte secondaire"
				},
				{
					"slug": "trait",
					"color": "#B9BCCF",
					"name": "Trait"
				},
				{
					"slug": "accent",
					"color": "#135BEA",
					"name": "Bleu"
				},
				{
					"slug": "sur-accent",
					"color": "#F3F4F6",
					"name": "Sur bleu"
				},
				{
					"slug": "nuit",
					"color": "#07115E",
					"name": "Bleu nuit"
				},
				{
					"slug": "roi",
					"color": "#0B0EB4",
					"name": "Bleu roi"
				},
				{
					"slug": "ciel",
					"color": "#84A8F0",
					"name": "Bleu ciel (grands titres décoratifs)"
				}
			]
		},
		"typography": {
			"fluid": {
				"minFontSize": "16px",
				"maxViewportWidth": "1320px"
			},
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "titre",
					"name": "Titres",
					"fontFamily": "'Manrope', system-ui, -apple-system, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "texte",
					"name": "Texte",
					"fontFamily": "'Manrope', system-ui, -apple-system, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "petit",
					"name": "Petit",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "normal",
					"name": "Normal",
					"size": "1.125rem",
					"fluid": false
				},
				{
					"slug": "grand",
					"name": "Grand",
					"size": "1.25rem",
					"fluid": false
				},
				{
					"slug": "titre-3",
					"name": "Titre 3",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "titre-2",
					"name": "Titre 2",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2rem"
					}
				},
				{
					"slug": "titre-1",
					"name": "Titre 1",
					"size": "5.625rem",
					"fluid": {
						"min": "2.75rem",
						"max": "5.625rem"
					}
				},
				{
					"slug": "geant",
					"name": "Géant (décoratif)",
					"size": "12.5rem",
					"fluid": {
						"min": "4.5rem",
						"max": "12.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Petit",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "Moyen",
					"size": "clamp(1.5rem, 3vw, 2.5rem)"
				},
				{
					"slug": "60",
					"name": "Grand",
					"size": "clamp(3rem, 6vw, 5rem)"
				},
				{
					"slug": "80",
					"name": "Section",
					"size": "clamp(4rem, 10vw, 8rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--fond)",
			"text": "var(--wp--preset--color--encre)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--texte)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.5"
		},
		"spacing": {
			"padding": {
				"left": "clamp(16px, 2.5vw, 48px)",
				"right": "clamp(16px, 2.5vw, 48px)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titre)",
					"fontWeight": "500",
					"lineHeight": "0.95",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--titre-1)",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--titre-2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--titre-3)"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--sur-accent)"
				},
				"typography": {
					"fontSize": "1.25rem",
					"fontWeight": "400",
					"lineHeight": "1.1"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"bottom": "12px",
						"left": "12px",
						"right": "12px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--nuit)",
						"text": "var(--wp--preset--color--sur-accent)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titre)",
					"fontSize": "1.375rem",
					"fontWeight": "800"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "1.25rem",
					"fontWeight": "400"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "En-tête",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pied de page",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-pleine-largeur",
			"title": "Page pleine largeur",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-visuel",
			"title": "Page avec photo d’en-tête",
			"postTypes": [
				"page"
			]
		}
	]
}